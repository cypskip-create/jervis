# Local overrides only. Never put broker passwords or API keys in this file.
TRADING_PLATFORM_APP_NAME=Quant MT5 Platform
TRADING_PLATFORM_MODE=paper
TRADING_PLATFORM_DATABASE_URL=sqlite:///./dev.sqlite3
TRADING_PLATFORM_GLOBAL_ENABLED=false
TRADING_PLATFORM_AUTH_SIGNING_KEY=replace-with-at-least-32-random-bytes
TRADING_PLATFORM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRADING_PLATFORM_MT5_DEMO_SERVER=
TRADING_PLATFORM_MT5_DEMO_ACCOUNT_IDS=
TRADING_PLATFORM_MT5_TERMINAL_PATH=
TRADING_PLATFORM_MT5_MAX_QUOTE_AGE_SECONDS=5
